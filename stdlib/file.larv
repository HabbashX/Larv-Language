// ═══════════════════════════════════════════════════════════════════════
//  Larv File System Standard Library
//
//  Written 100% in Larv. Every JVM operation is delegated through the FFI
//  (include ... from "...java..."), so this library runs identically in the
//  interpreter and the compiled mode.
//
//  Usage:
//      import "stdlib.file"
//
//      fileWrite("notes.txt", "hello")
//      print(fileRead("notes.txt"))
//      print(fileList("."))
// ═══════════════════════════════════════════════════════════════════════

include Files from "java.nio.file.Files"
include Paths from "java.nio.file.Paths"

// ── reading ─────────────────────────────────────────────────────────────

// Returns the entire content of a file as a single string.
func fileRead(path) {
    return Files.readString(Paths.get(path))
}

// Returns the lines of a text file as a list of strings.
func fileLines(path) {
    return Files.readAllLines(Paths.get(path))
}

// ── writing ─────────────────────────────────────────────────────────────

// Writes text to a file, replacing any existing content.
func fileWrite(path, content) {
    Files.writeString(Paths.get(path), content)
    return true
}

// Appends text to the end of a file, creating the file if it does not exist.
func fileAppend(path, content) {
    if (fileExists(path)) {
        Files.writeString(Paths.get(path), fileRead(path) + content)
    } else {
        Files.writeString(Paths.get(path), content)
    }
    return true
}

// ── existence & type ────────────────────────────────────────────────────

// Returns true when the path exists (file or directory).
func fileExists(path) {
    return Files.exists(Paths.get(path))
}

// Returns true when the path is a regular file.
func fileIsFile(path) {
    return Files.isRegularFile(Paths.get(path))
}

// Returns true when the path is a directory.
func fileIsDir(path) {
    return Files.isDirectory(Paths.get(path))
}

// ── metadata ────────────────────────────────────────────────────────────

// Returns the size of the file in bytes.
func fileSize(path) {
    return Files.size(Paths.get(path))
}

// Returns the file name without its directory part.
func fileName(path) {
    return Paths.get(path).getFileName().toString()
}

// Returns the parent directory path, or "" when the path has no parent.
func fileParent(path) {
    var parent = Paths.get(path).getParent()
    if (parent == nil) {
        return ""
    }
    return parent.toString()
}

// Returns the file extension without the leading dot ("" when there is none).
func fileExtension(path) {
    var parts = path.split(".")
    var size = 0
    for part in parts {
        size = size + 1
    }
    if (size <= 1) {
        return ""
    }
    return parts[size - 1]
}

// ── listing ─────────────────────────────────────────────────────────────

// Returns the names of the entries inside a directory, as a list of strings.
func fileList(path) {
    var entries = []
    for entry in Files.list(Paths.get(path)).toList() {
        entries.push(entry.getFileName().toString())
    }
    return entries
}

// ── directories ─────────────────────────────────────────────────────────

// Creates a single directory. Fails if it already exists.
func fileMkdir(path) {
    Files.createDirectory(Paths.get(path))
    return true
}

// Creates a directory and any missing parents. Succeeds if it already exists.
func fileMkdirs(path) {
    Files.createDirectories(Paths.get(path))
    return true
}

// ── removal ─────────────────────────────────────────────────────────────

// Deletes a file or empty directory. Returns false when the path did not exist.
func fileDelete(path) {
    return Files.deleteIfExists(Paths.get(path))
}

// ── copy & move ─────────────────────────────────────────────────────────

// Copies a file. The target must not already exist.
func fileCopy(src, dst) {
    Files.copy(Paths.get(src), Paths.get(dst))
    return true
}

// Moves or renames a file or directory. The target must not already exist.
func fileMove(src, dst) {
    Files.move(Paths.get(src), Paths.get(dst))
    return true
}